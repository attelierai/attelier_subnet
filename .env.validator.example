# Attelier SN126 Validator configuration (Finney mainnet, netuid 126)
# Copy to .env and set your registered Bittensor validator wallet & hotkey:
#   cp .env.validator.example .env

# Required: your registered SN126 validator coldkey wallet name & hotkey name
WALLET_NAME=default
WALLET_HOTKEY=default

# Optional: host path to your Bittensor wallets directory (mounted read-only in Docker)
HOST_WALLETS_DIR=~/.bittensor/wallets

# Optional: persistent state directory for validator journal & status files
HOST_STATE_DIR=./state/validator

# Optional: Finney (default) or your own Subtensor WebSocket RPC (ws:// or wss://)
BITTENSOR_NETWORK=finney

# Optional: polling interval in seconds (default 60)
INTERVAL_SECONDS=60

# Validator mode:
#   validator (default) — verifies Attelier's Ed25519-signed allocation feed directly (zero lag, same tempo)
#   light               — copies the primary validator's finalized on-chain weights
VALIDATOR_ROLE=validator
VALIDATOR_IM=api
